  "requiredArtifacts": [
    {
      "id": "prerequisite_state_table",
      "schema": "ozone-manager/references/schemas/prerequisite_state_table.schema.json",
      "requiredWhen": "ozm-external-prerequisite-gate is activated and prerequisite_state_table governs the next downstream claim or action",
      "claimCeilingIfMissing": "artifact_missing_or_candidate_only"
    },
    {
      "id": "fallback_boundary",
      "schema": "ozone-manager/references/schemas/fallback_boundary.schema.json",
      "requiredWhen": "ozm-external-prerequisite-gate is activated and fallback_boundary governs the next downstream claim or action",
      "claimCeilingIfMissing": "artifact_missing_or_candidate_only"
    },
    {
      "id": "external_write_policy",
      "schema": "ozone-manager/references/schemas/external_write_policy.schema.json",
      "requiredWhen": "ozm-external-prerequisite-gate is activated and external_write_policy governs the next downstream claim or action",
      "claimCeilingIfMissing": "artifact_missing_or_candidate_only"
    }
  ],
  "validators": [
    {
      "script": "ozm-external-prerequisite-gate/scripts/external_prerequisite_gate_check.py",
      "appliesTo": [
        "prerequisite_state",
        "fallback_label",
        "live_claim_ceiling",
        "prerequisite_state_table",
        "fallback_boundary",
        "external_write_policy"
      ],
      "mustPassBefore": [
        "positive_claim",
        "closeout"
      ]
