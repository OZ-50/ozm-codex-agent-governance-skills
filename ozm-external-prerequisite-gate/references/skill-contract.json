      "consumer": "ozm-dispatch-freeze",
      "field": "prerequisite_status",
      "required": true
    },
    {
      "consumer": "ozm-claim-ceiling",
      "field": "live_claim_ceiling",
      "required": true
    }
  ],
  "claimTransitions": [
    {
      "from": "planned",
      "to": "artifact_present",
      "requires": [
        "prerequisite_state_table",
        "fallback_boundary",
        "external_write_policy"
      ],
      "validator": "ozm-external-prerequisite-gate/scripts/external_prerequisite_gate_check.py"
    },
    {
      "from": "artifact_present",
      "to": "reviewed",
      "requires": [
        "prerequisite_status",
        "live_claim_ceiling"
      ],
      "validator": "ozm-external-prerequisite-gate/scripts/external_prerequisite_gate_check.py"
    }
  ],
  "nonSurfaceFailures": [
    "ozm-external-prerequisite-gate_loaded_without_required_activation_effect"
  ],
  "paperEvidenceClass": "contractual_control_surface"
