{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.claim_source_alignment.v1",
  "title": "OZM reference method claim-source alignment artifact",
  "type": "object",
  "required": [
    "schema",
    "artifact_id",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "ozm.claim_source_alignment.v1"
    },
    "artifact_id": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_type",
          "text",
          "source_refs",
          "evidence_strength",
          "alignment_verdict",
          "claim_ceiling_if_not_entailed"
        ],
        "properties": {
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "span"
              ],
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
