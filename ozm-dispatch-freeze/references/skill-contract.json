      "requiredWhen": "ozm-dispatch-freeze is activated and dispatch_freeze_receipt governs the next downstream claim or action",
      "claimCeilingIfMissing": "artifact_missing_or_candidate_only"
    },
    {
      "id": "allowed_write_set",
      "schema": "ozone-manager/references/schemas/allowed_write_set.schema.json",
      "requiredWhen": "ozm-dispatch-freeze is activated and allowed_write_set governs the next downstream claim or action",
      "claimCeilingIfMissing": "artifact_missing_or_candidate_only"
    },
    {
      "id": "packet_gate_plan",
      "schema": "ozone-manager/references/schemas/packet_gate_plan.schema.json",
      "requiredWhen": "ozm-dispatch-freeze is activated and packet_gate_plan governs the next downstream claim or action",
      "claimCeilingIfMissing": "artifact_missing_or_candidate_only"
    }
  ],
  "validators": [
