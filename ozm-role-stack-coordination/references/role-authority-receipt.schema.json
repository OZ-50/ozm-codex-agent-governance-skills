{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.role_authority_receipt.v1",
  "type": "object",
  "required": ["role", "carrier", "allowed_actions", "forbidden_claims", "context_pack_hash", "result_pack_hash"],
  "properties": {
    "role": {"enum": ["controller", "planner", "writer", "reviewer", "auditor", "subagent", "tool"]},
    "carrier": {"type": "string"},
    "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_claims": {"type": "array", "items": {"type": "string"}},
    "context_pack_hash": {"type": "string"},
    "result_pack_hash": {"type": "string"},
    "redaction_policy": {"type": "string"}
  },
  "additionalProperties": true
}
