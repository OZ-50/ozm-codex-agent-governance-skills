{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.context_pack_manifest.v1",
  "type": "object",
  "required": ["pack_id", "included", "excluded", "constraint_ids", "claim_ceiling", "stale_when", "reload_trigger"],
  "properties": {
    "pack_id": {"type": "string", "minLength": 1},
    "included": {"type": "array", "items": {"type": "string"}},
    "excluded": {"type": "array", "items": {"type": "object", "required": ["surface", "reason"], "properties": {"surface": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": true}},
    "constraint_ids": {"type": "array", "items": {"type": "string"}},
    "owner_rows": {"type": "array", "items": {"type": "string"}},
    "preservation_score": {"type": "number", "minimum": 0, "maximum": 1},
    "claim_ceiling": {"type": "string"},
    "stale_when": {"type": "array", "items": {"type": "string"}},
    "reload_trigger": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
