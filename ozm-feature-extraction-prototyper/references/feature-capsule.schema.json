{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.feature_capsule.v1",
  "type": "object",
  "required": ["capsule_id", "source_evidence", "interface_contract", "negative_scope", "reuse_tests", "promotion_threshold"],
  "properties": {
    "capsule_id": {"type": "string"},
    "source_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "interface_contract": {"type": "string"},
    "negative_scope": {"type": "array", "items": {"type": "string"}},
    "reuse_tests": {"type": "array", "items": {"type": "string"}},
    "promotion_threshold": {"type": "string"},
    "independent_review_verdict": {"type": "string"}
  },
  "additionalProperties": true
}
