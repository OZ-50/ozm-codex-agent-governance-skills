{
  "schema": "ozm.skill_contract.v3.1",
  "skill": "ozm-wait-block-replay-replacement",
  "activationTriggers": {
    "ownerStrongPhrases": [
      "stalled lane",
      "clean wait",
      "nonstart",
      "replay candidate",
      "replacement candidate",
      "classify nonstart"
    ],
    "ownerWeakKeywords": [
      "stalled lane",
      "clean wait",
      "nonstart",
      "replay candidate",
      "辅助",
      "任务执行",
      "auxiliary",
      "auxiliary thread"
    ],
    "companionStrongPhrases": [],
    "companionWeakKeywords": [],
    "negativeTriggers": [
      "metadata-only mention",
      "route output without SKILL.md hydration",
      "pre-compaction receipt reused after compaction"
    ]
  },
  "ownerQuestions": [
    "Use when an OZM-governed lane appears stalled and must be classified honestly as clean wait, nonstart, replay, replacement, blocker, or historical-only without corrupting ownership."
  ],
  "preconditions": [
    "ozm-wait-block-replay-replacement selected by ozone-manager for a matching OZM-governed request",
    "latest visible request role and authority class are classified",
    "owner surfaces or explicit absence are recorded"
  ],
  "blockingConditions": [
    "stalled lane is blindly replayed",
    "replacement would corrupt owner surface or duplicate writer work"
  ],
  "requiredArtifacts": [
    {
      "id": "lane_state_classification",
      "schema": "ozone-manager/references/schemas/lane_state_classification.schema.json",
      "requiredWhen": "ozm-wait-block-replay-replacement is activated and lane_state_classification governs the next downstream claim or action",
      "claimCeilingIfMissing": "artifact_missing_or_candidate_only"
    },
    {
      "id": "replay_or_replacement_decision",
      "schema": "ozone-manager/references/schemas/replay_or_replacement_decision.schema.json",
      "requiredWhen": "ozm-wait-block-replay-replacement is activated and replay_or_replacement_decision governs the next downstream claim or action",
      "claimCeilingIfMissing": "artifact_missing_or_candidate_only"
    },
    {
      "id": "ownership_boundary_receipt",
      "schema": "ozone-manager/references/schemas/ownership_boundary_receipt.schema.json",
      "requiredWhen": "ozm-wait-block-replay-replacement is activated and ownership_boundary_receipt governs the next downstream claim or action",
      "claimCeilingIfMissing": "artifact_missing_or_candidate_only"
    }
  ],
  "validators": [
    {
      "script": "ozm-wait-block-replay-replacement/scripts/lane_state_check.py",
      "appliesTo": [
        "lane_status",
        "replacement_receipt",
        "handoff_pair",
        "lane_state_classification",
        "replay_or_replacement_decision",
        "ownership_boundary_receipt"
      ],
      "mustPassBefore": [
        "positive_claim",
        "closeout"
      ]
    }
  ],
  "downstreamBindings": [
    {
      "consumer": "ozm-dispatch-freeze",
      "field": "replay_admission",
      "required": true
    },
    {
      "consumer": "ozm-record-surface-management",
      "field": "lane_state_record",
      "required": true
    }
  ],
  "claimTransitions": [
    {
      "from": "planned",
      "to": "artifact_present",
      "requires": [
        "lane_state_classification",
        "replay_or_replacement_decision",
        "ownership_boundary_receipt"
      ],
      "validator": "ozm-wait-block-replay-replacement/scripts/lane_state_check.py"
    },
    {
      "from": "artifact_present",
      "to": "reviewed",
      "requires": [
        "replay_admission",
        "lane_state_record"
      ],
      "validator": "ozm-wait-block-replay-replacement/scripts/lane_state_check.py"
    }
  ],
  "nonSurfaceFailures": [
    "ozm-wait-block-replay-replacement_loaded_without_required_activation_effect"
  ],
  "paperEvidenceClass": "contractual_control_surface"
}
