{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.closeout_handoff_packet.schema.json",
  "title": "OZM handoff_packet artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "next_consumer",
    "unresolved_constraints",
    "replay_bundle"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "handoff_packet"
    },
    "skill": {
      "type": "string",
      "const": "ozm-closeout-handoff"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_consumer": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "unresolved_constraints": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "replay_bundle": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
