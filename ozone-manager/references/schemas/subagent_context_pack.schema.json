{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.subagent_context_pack.schema.json",
  "title": "OZM subagent_context_pack artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "bundle_items"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "subagent_context_pack"
    },
    "skill": {
      "type": "string",
      "const": "ozm-role-stack-coordination"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_class": {
      "type": "string"
    },
    "downstream_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bundle_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
