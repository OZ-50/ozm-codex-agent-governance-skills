{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.review_diffgate_verdict.schema.json",
  "title": "OZM diffgate_verdict artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "verdict",
    "constraint_labels"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "diffgate_verdict"
    },
    "skill": {
      "type": "string",
      "const": "ozm-review-diffgate-acceptance"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "constraint_labels": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
