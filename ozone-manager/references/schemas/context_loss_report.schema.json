{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.context_loss_report.schema.json",
  "title": "OZM context_loss_report artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "lost_surfaces",
    "recovery_action"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "context_loss_report"
    },
    "skill": {
      "type": "string",
      "const": "ozm-context-engineering"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lost_surfaces": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "recovery_action": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
