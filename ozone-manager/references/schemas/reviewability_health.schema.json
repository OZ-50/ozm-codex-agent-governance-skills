{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.reviewability_health.schema.json",
  "title": "OZM reviewability_health artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "reviewability_health"
    },
    "skill": {
      "type": "string",
      "const": "ozm-review-diffgate-acceptance"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
