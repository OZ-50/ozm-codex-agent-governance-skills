{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.record_provenance_entry.schema.json",
  "title": "OZM record_provenance_entry artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "record_id",
    "authority_class",
    "stale_when"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "record_provenance_entry"
    },
    "skill": {
      "type": "string",
      "const": "ozm-record-surface-management"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "record_id": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "authority_class": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "stale_when": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
