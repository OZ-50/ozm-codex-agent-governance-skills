{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.tool_contract_table.schema.json",
  "title": "OZM tool_contract_table artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "table_rows"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "tool_contract_table"
    },
    "skill": {
      "type": "string",
      "const": "ozm-agent-runtime-architecture"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_class": {
      "type": "string"
    },
    "downstream_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "table_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
