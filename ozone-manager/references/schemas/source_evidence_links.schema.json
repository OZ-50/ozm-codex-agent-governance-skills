{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.source_evidence_links.schema.json",
  "title": "OZM source_evidence_links artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "linked_entries"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "source_evidence_links"
    },
    "skill": {
      "type": "string",
      "const": "ozm-feature-extraction-prototyper"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_class": {
      "type": "string"
    },
    "downstream_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
