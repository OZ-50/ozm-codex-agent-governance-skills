{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.requirement_intake_contract.schema.json",
  "title": "OZM intake_contract artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "owner_surface",
    "success_criteria",
    "non_goals"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "intake_contract"
    },
    "skill": {
      "type": "string",
      "const": "ozm-requirement-load"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_surface": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "success_criteria": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "non_goals": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
