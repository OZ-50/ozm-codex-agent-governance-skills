{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.draft_intake_gate.schema.json",
  "title": "OZM draft_intake_gate artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "audience",
    "reader_action",
    "source_set"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "draft_intake_gate"
    },
    "skill": {
      "type": "string",
      "const": "ozm-document-drafting"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audience": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "reader_action": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "source_set": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
