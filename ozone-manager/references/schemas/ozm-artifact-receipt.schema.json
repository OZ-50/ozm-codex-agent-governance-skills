{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.artifact_receipt.v1",
  "title": "OZM Artifact Receipt",
  "type": "object",
  "required": ["id", "authority_class", "claim_ceiling"],
  "properties": {
    "id": {"type": "string"},
    "authority_class": {"type": "string"},
    "claim_ceiling": {"type": "string"},
    "owner_skill": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "validator_refs": {"type": "array", "items": {"type": "string"}},
    "downstream_consumers": {"type": "array", "items": {"type": "string"}},
    "stale_when": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
