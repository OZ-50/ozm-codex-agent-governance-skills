{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.instruction_surface_posture.schema.json",
  "title": "OZM instruction_surface_posture artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "posture"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "instruction_surface_posture"
    },
    "skill": {
      "type": "string",
      "const": "ozm-new-project-setup"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_class": {
      "type": "string"
    },
    "downstream_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "posture": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
