{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.acceptance_receipt.schema.json",
  "title": "OZM acceptance_evidence_matrix artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "accepted_scope",
    "remaining_nonclaims"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "acceptance_evidence_matrix"
    },
    "skill": {
      "type": "string",
      "const": "ozm-review-diffgate-acceptance"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepted_scope": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "remaining_nonclaims": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
