{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.active_surface_sweep.schema.json",
  "title": "OZM active_surface_sweep artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "swept_roots",
    "residue",
    "claim_effect"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "active_surface_sweep"
    },
    "skill": {
      "type": "string",
      "const": "ozm-closeout-handoff"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "swept_roots": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "residue": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "claim_effect": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
