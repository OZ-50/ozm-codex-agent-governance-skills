{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.claim_candidate.schema.json",
  "title": "OZM claim_candidate artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "claim_text",
    "scope"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "claim_candidate"
    },
    "skill": {
      "type": "string",
      "const": "ozm-claim-ceiling"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_text": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "scope": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
