{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.code_write_changed_file_manifest.schema.json",
  "title": "OZM changed_file_manifest artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "files",
    "change_class"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "changed_file_manifest"
    },
    "skill": {
      "type": "string",
      "const": "ozm-code-writing"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "change_class": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
