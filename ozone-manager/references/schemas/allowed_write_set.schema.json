{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.allowed_write_set.schema.json",
  "title": "OZM allowed_write_set artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "paths",
    "forbidden_surfaces"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "allowed_write_set"
    },
    "skill": {
      "type": "string",
      "const": "ozm-dispatch-freeze"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paths": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "forbidden_surfaces": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
