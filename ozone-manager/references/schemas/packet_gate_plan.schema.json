{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.packet_gate_plan.schema.json",
  "title": "OZM packet_gate_plan artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "gate_tier",
    "targeted_gates",
    "full_gate_triggers"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "packet_gate_plan"
    },
    "skill": {
      "type": "string",
      "const": "ozm-dispatch-freeze"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate_tier": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "targeted_gates": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "full_gate_triggers": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
