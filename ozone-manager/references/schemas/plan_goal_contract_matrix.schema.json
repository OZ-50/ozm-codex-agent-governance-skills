{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.plan_goal_contract_matrix.schema.json",
  "title": "OZM plan_goal_contract_matrix artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "rows",
    "acceptance_ids"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "plan_goal_contract_matrix"
    },
    "skill": {
      "type": "string",
      "const": "ozm-requirement-load"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "acceptance_ids": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
