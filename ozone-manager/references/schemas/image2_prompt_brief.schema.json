{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.image2_prompt_brief.schema.json",
  "title": "OZM image2_prompt_brief artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "brief_sections"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "image2_prompt_brief"
    },
    "skill": {
      "type": "string",
      "const": "ozm-image2-skill"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_class": {
      "type": "string"
    },
    "downstream_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brief_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
