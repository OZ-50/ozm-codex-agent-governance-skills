{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.text_preflight_report.schema.json",
  "title": "OZM text_preflight_report artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "report_findings"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "text_preflight_report"
    },
    "skill": {
      "type": "string",
      "const": "ozm-text-io-integrity"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_class": {
      "type": "string"
    },
    "downstream_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
