{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.claim_ceiling_decision.schema.json",
  "title": "OZM ceiling_decision artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "current_ceiling",
    "proof_gap"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "ceiling_decision"
    },
    "skill": {
      "type": "string",
      "const": "ozm-claim-ceiling"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_ceiling": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "proof_gap": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
