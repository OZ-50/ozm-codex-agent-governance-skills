{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.prerequisite_state_table.schema.json",
  "title": "OZM prerequisite_state_table artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "prerequisites",
    "posture"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "prerequisite_state_table"
    },
    "skill": {
      "type": "string",
      "const": "ozm-external-prerequisite-gate"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "posture": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
