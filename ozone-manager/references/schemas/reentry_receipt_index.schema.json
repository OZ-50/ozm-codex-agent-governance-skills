{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.reentry_receipt_index.schema.json",
  "title": "OZM reentry_or_receipt_index artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "epoch",
    "owner_surfaces",
    "latest_request_binding"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "reentry_or_receipt_index"
    },
    "skill": {
      "type": "string",
      "const": "ozm-record-surface-management"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "epoch": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "owner_surfaces": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "latest_request_binding": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
