{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.code_health_result.schema.json",
  "title": "OZM agentic_code_health_result artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "status",
    "profile",
    "warnings"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "agentic_code_health_result"
    },
    "skill": {
      "type": "string",
      "const": "ozm-code-writing"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "profile": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "warnings": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
