{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.root_cause_trace.schema.json",
  "title": "OZM root_cause_trace artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "trace_steps"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "root_cause_trace"
    },
    "skill": {
      "type": "string",
      "const": "ozm-error-repair-debug"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_class": {
      "type": "string"
    },
    "downstream_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
