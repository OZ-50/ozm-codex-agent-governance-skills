{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.role_stack_receipt.schema.json",
  "title": "OZM role_stack_receipt artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "receipt_status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "role_stack_receipt"
    },
    "skill": {
      "type": "string",
      "const": "ozm-role-stack-coordination"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_class": {
      "type": "string"
    },
    "downstream_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receipt_status": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
