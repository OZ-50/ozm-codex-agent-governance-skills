{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.compaction_receipt.schema.json",
  "title": "OZM compaction_receipt artifact schema",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "claim_ceiling",
    "evidence_refs",
    "constraint_ids",
    "pre_compaction_state",
    "post_compaction_rebind"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "compaction_receipt"
    },
    "skill": {
      "type": "string",
      "const": "ozm-context-engineering"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pre_compaction_state": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    },
    "post_compaction_rebind": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number"
      ]
    }
  },
  "additionalProperties": true
}
