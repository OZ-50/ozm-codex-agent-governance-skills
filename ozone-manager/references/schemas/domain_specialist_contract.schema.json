{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.domain_specialist_contract.schema.json",
  "title": "OZM domain specialist contract artifact",
  "type": "object",
  "required": [
    "artifact_id",
    "skill",
    "domain",
    "proof_surfaces",
    "negative_tests",
    "external_prerequisites",
    "rollback_or_recovery",
    "claim_ceiling"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "proof_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "negative_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_or_recovery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_ceiling": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
