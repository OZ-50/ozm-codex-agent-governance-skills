{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.document.provenance_graph.v1",
  "title": "OZM Document Provenance Graph",
  "type": "object",
  "required": ["claims", "source_nodes", "edges"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "section", "claim_text", "claim_ceiling"],
        "properties": {
          "claim_id": {"type": "string"},
          "section": {"type": "string"},
          "claim_text": {"type": "string"},
          "claim_ceiling": {"type": "string"},
          "counterpoint_or_boundary": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "source_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "source_ref", "authority_class"],
        "properties": {
          "source_id": {"type": "string"},
          "source_ref": {"type": "string"},
          "authority_class": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "source_id", "relation", "passage_span"],
        "properties": {
          "claim_id": {"type": "string"},
          "source_id": {"type": "string"},
          "relation": {"type": "string"},
          "passage_span": {"type": "string"},
          "reasoning_bridge": {"type": "string"},
          "conflict_disposition": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
