#!/usr/bin/env bash

set -e

if [ "${OZM_ALLOW_GH_PR_TOOLS:-}" != "1" ]; then
    echo '{"status":"fail","issues":[{"severity":"error","code":"network_tool_requires_authorization","message":"Set OZM_ALLOW_GH_PR_TOOLS=1 only after user approval before running GitHub network helpers."}]}'
    exit 1
fi

if [ $# -eq 0 ]; then
    echo "Usage: resolve-pr-thread THREAD_ID"
    echo "Example: resolve-pr-thread PRRT_kwDOABC123"
    exit 1
fi

THREAD_ID=$1

gh api graphql -f threadId="$THREAD_ID" -f query='
mutation ResolveReviewThread($threadId: ID!) {
  resolveReviewThread(input: {threadId: $threadId}) {
    thread {
      id
      isResolved
      path
      line
    }
  }
}'
