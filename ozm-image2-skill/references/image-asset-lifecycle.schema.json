    "prompt_brief": {"type": "string"},
    "generated_asset_ref": {"type": "string"},
    "integration_ref": {"type": "string"},
    "visual_qa_receipt": {"type": "string"},
    "style_consistency": {"type": "string"},
    "sequence_constraints": {"type": "array", "items": {"type": "string"}},
