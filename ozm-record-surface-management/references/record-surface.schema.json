{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.record_surface.v1",
  "type": "object",
  "required": ["record_id", "authority", "freshness", "source_hash", "stale_when", "owner_surface_link"],
  "properties": {
    "record_id": {"type": "string"},
    "authority": {"enum": ["controller_truth", "execution_record", "candidate_delta", "navigation", "historical_only", "scratch"]},
    "freshness": {"type": "string"},
    "source_hash": {"type": "string"},
    "stale_when": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "owner_surface_link": {"type": "string"},
    "batch_id": {"type": "string"}
  },
  "additionalProperties": true
}
