{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozm.closeout_replay_bundle.v1",
  "type": "object",
  "required": ["packet_ids", "artifacts", "validators", "skipped_checks", "open_constraints", "next_trigger", "claim_ceiling"],
  "properties": {
    "packet_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "validators": {"type": "array", "items": {"type": "string"}},
    "skipped_checks": {"type": "array", "items": {"type": "string"}},
    "open_constraints": {"type": "array", "items": {"type": "string"}},
    "next_trigger": {"type": "string"},
    "eval_run_manifest": {"type": "string"},
    "claim_ceiling": {"type": "string"},
    "debt_class": {"enum": ["known_safe_debt", "blocking_debt", "future_improvement", "none"]}
  },
  "additionalProperties": true
}
